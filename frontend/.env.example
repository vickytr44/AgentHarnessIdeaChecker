# CopilotKit Intelligence API Key
CPK_INTELLIGENCE_API_KEY=your_copilotkit_api_key_here
CPK_TELEMETRY_ID=your_telemetry_id_here

# LLM Provider Keys
OPENAI_API_KEY=your_gemini_or_openai_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Suppress AG-UI protocol transformation warnings & telemetry notices
SUPPRESS_TRANSFORMATION_WARNINGS=true
COPILOTKIT_TELEMETRY_DISABLED=true
