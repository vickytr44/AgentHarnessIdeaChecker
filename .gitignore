# ==========================================
# Comprehensive .gitignore for ChatGroup
# (.NET Agent Harness Backend + Next.js Frontend)
# ==========================================

# ------------------------------------------
# Secrets & Configuration Files (CRITICAL)
# ------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example

# ASP.NET Configuration with secrets
appsettings.json
appsettings.*.json
!appsettings.example.json
!appsettings.template.json
!**/appsettings.example.json
!**/appsettings.template.json

# Keys and certificates
*.pem
*.key
*.pfx
*.p12

# ------------------------------------------
# .NET / C# Build Artifacts & Memory
# ------------------------------------------
[Bb]in/
[Oo]bj/
**/bin/
**/obj/
agent-file-memory/
**/agent-file-memory/
test_req.json

# Visual Studio / Rider / C# IDE Files
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.pidb
*.booproj
*.svclog
*.publishsettings
_ReSharper*/
*.DotSettings.user

# ------------------------------------------
# Node.js & Next.js Build Outputs
# ------------------------------------------
node_modules/
**/node_modules/
.next/
**/[.]next/
out/
build/
dist/
coverage/

# TypeScript & Next build metadata
*.tsbuildinfo
next-env.d.ts

# Package manager files
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# Vercel & Deployment
# ------------------------------------------
.vercel

# ------------------------------------------
# Operating System & IDE
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*~
